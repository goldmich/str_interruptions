# subset loci to coding overlap
# merge loci to avoid issues w multiple alleles?
# subset chr vcf
# add perfect repeat in phase? (this will be done in separate script)
# run vep, parse output
rule get_coding_loci_chr:
	input: 
		locus_characteristics = '%s/tmp/coding_interruptions_manual_annotations.txt' % analysis_dir,
		vcf='%s/ensemble_{chr}_filtered.vcf.gz' % vcf_dir
	output: '%s/tmp/coding_loci.{chr}.bcf.gz' % analysis_dir
	params: sge_opts=params_default
	shell: """
	
		module load bedtools
		module load bcftools/1.16
		awk '{{if ($15 !~ /\./ && $1 ~ /{wildcards.chr}$/) print $1 "\t" $2 "\t" $3 }}' {input.locus_characteristics} | \
			bedtools merge -i stdin > ./tmp/coding_loci.{wildcards.chr}.txt
		
		bcftools view -R ./tmp/coding_loci.{wildcards.chr}.txt -O b {input.vcf} > {output}
		rm ./tmp/coding_loci.{wildcards.chr}.txt
	
	"""

rule add_perfect_allele_to_coding_loci:
	input: '%s/tmp/coding_loci.{chr}.bcf.gz' % analysis_dir
	output: '%s/tmp/coding_loci_w_perfect_repeat.{chr}.bcf.gz' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/add_perfect_allele_to_coding_loci.py' % analysis_dir

rule run_vep_coding_loci:
	input: '%s/tmp/coding_loci_w_perfect_repeat.{chr}.bcf.gz' % analysis_dir
	output: '%s/tmp/coding_loci_w_perfect_repeat_annotations.{chr}.txt' % analysis_dir
	params: sge_opts=params_default
	shell: """
	
		module load vep/104.2
	
		vep --cache --dir_cache /scratch/ucgd/lustre/common/data/vep_cache \
		 --fasta /scratch/ucgd/lustre/common/data/Reference/GRCh38/human_g1k_v38_decoy_phix.fasta \
		 --input_file {input} --output_file {output} --everything --force_overwrite
	
	"""

rule interpret_vep:
	input: '%s/tmp/coding_loci_w_perfect_repeat_annotations.{chr}.txt' % analysis_dir,
	output: '%s/tmp/coding_loci_annotated.{chr}.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/interpret_vep.py' % analysis_dir

rule sum_vep_interpretations:
	input: expand('%s/tmp/coding_loci_annotated.{chr}.txt' % analysis_dir, chr = AUTOSOMES)
	output: '%s/tmp/coding_loci_annotated.txt' % analysis_dir
	params: sge_opts=params_default
	shell: """
	
	cat {input} > {output}
	
	"""

rule add_annotation_to_coding_loci:
	input:
		coding_annotations = '%s/tmp/coding_loci_annotated.txt' % analysis_dir,
		coding_locus_characteristics = '%s/tmp/coding_interruptions_manual_annotations.txt' % analysis_dir
	output: '%s/tmp/coding_interruptions_vep.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/add_vep_annotation_to_coding_loci.py' % analysis_dir

# eventually i will port over all the gnomad analysis from the harris servers but today is not that day
# for now i just want to exclude sites that are overlapping coding regions at all, not worried about partial vs full overlap
rule gnomad_interruptions_annotate_coding:
	input: 
		gtf_bed = '%s/tmp/gtf_coding_exons.hg38.bed' % analysis_dir,
		gnomad_loci = '%s/gnomad_interruptions_af.txt' % analysis_dir
	output: '%s/gnomad_interruptions_af_coding.txt' % analysis_dir
	params: sge_opts=params_default
	shell: """
		
		module load bedtools
		
		awk '{{print $1 "\t" $2 "\t" $3 * length($4) + $2 "\t" $3 "\t" $4 "\t" $5  "\t" $6  "\t" $7}}' {input.gnomad_loci} > tmp/gnomad_interruptions_af.bed
		
		bedtools merge -i {input.gtf_bed} -c 4,5 -o distinct |
		 bedtools intersect -a tmp/gnomad_interruptions_af.bed -b stdin -loj |
		 bedtools groupby -g 1-8 -c 9,10 -o distinct,distinct > {output}
		
		rm tmp/gnomad_interruptions_af.bed
	
	"""

rule process_pfam_bed:
	input: pfam_file
	output: '%s/tmp/pfam.gencode.grch38.single_line.bed' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/process_pfam_bed.py' % analysis_dir
	
# pfam is 0-indexed
# The vcf is 1-indexed but the end coordinate is not inclusive!
# This is unlike the gtf file above where it is 1-indexed and both ends are inclusive
# check to make sure that I didn't get rid of the wrong columns
rule intersect_pfam:
	input:
		pfam_bed = '%s/tmp/pfam.gencode.grch38.single_line.bed' % analysis_dir,
		coding_locus_characteristics = '%s/tmp/coding_interruptions_vep.txt' % analysis_dir
	output: '%s/coding_interruptions_full_annotations.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		module load bedtools
		
		awk '{{print $1 "\t" $2 + 1 "\t" $3 + 1 "\t" $4}}' {input.pfam_bed} | \
		 bedtools intersect -a {input.coding_locus_characteristics} -b stdin -f 1 -loj | \
		 bedtools groupby -g 1-24 -c 28 -o distinct | \
		 cut --complement -f5 > {output}
	
	"""

# you'll need to keep track of the order of the TF columns - worthwhile just printing them as a list
# probably want the -C option but would be nice to slim columns and/or rows down a bit before heading into R
rule intersect_tf_chip:
	input:
		locus_characteristics = '%s/tmp/interruptions_constraint.txt' % analysis_dir,
		tf_chip_list = glob.glob("%s/tf_chip_idr_peaks/*.bed.gz" % analysis_dir)
	output: '%s/tmp/interruptions_tf_chip_long.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		bedtools intersect -a {input.locus_characteristics} -b {input.tf_chip_list} -C -filenames > {output}
			
	"""	

rule collapse_tf_chip_output:
	input:
		locus_characteristics = '%s/tmp/interruptions_tf_chip_long.txt' % analysis_dir,
		tf_chip_table = glob.glob("%s/tf_chip_idr_peaks/tf_chip_idr_encode_accessions.csv" % analysis_dir)
	output: '%s/tmp/interruptions_tf_chip.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/collapse_tf_chip_intersect.py' % analysis_dir

# cpgi is 0-indexed, just add 1 to start position
rule intersect_cpgi:
	input:
		locus_characteristics = '%s/tmp/interruptions_tf_chip.txt' % analysis_dir,
		cpgi_file = cpgi_file
	output: '%s/tmp/interruptions_cpgi.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		awk '{{if ($1 !~ /^#/) print $2 "\t" $3 + 1 "\t" $4}}' {input.cpgi_file} |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -c > {output}
			
	"""	

rule intersect_fire_peaks:
	input:
		k562_wide_peaks = '%s/K562.FDR-wide-peaks.bed.gz' % analysis_dir,
		gm12878_wide_peaks = '%s/GM12878.FDR-wide-peaks.bed.gz' % analysis_dir,
		locus_characteristics = '%s/tmp/interruptions_cpgi.txt' % analysis_dir
	output: '%s/tmp/interruptions_fire.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		bedtools intersect -a {input.k562_wide_peaks} -b {input.gm12878_wide_peaks} |
		 awk '{{print $1 "\t" $2 + 1 "\t" $3}}' |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -c > {output}
		 	
	"""

rule intersect_ipsc_chip:
	input:
		ipsc_atac_peaks = '%s/ENCFF321VDH.bed.gz' % analysis_dir,
		locus_characteristics = '%s/tmp/interruptions_fire.txt' % analysis_dir
	output: '%s/tmp/interruptions_ipsc.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		gunzip -c {input.ipsc_atac_peaks} |
		 awk '{{print $1 "\t" $2 + 1 "\t" $3}}' |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -c > {output}
	
	"""

rule intersect_k562_gm12878_chip:
	input:
		k562_atac_peaks = '%s/ENCFF333TAT.bed.gz' % analysis_dir,
		gm12878_atac_peaks = '%s/ENCFF748UZH.bed.gz' % analysis_dir,
		locus_characteristics = '%s/tmp/interruptions_ipsc.txt' % analysis_dir
	output: '%s/tmp/interruptions_atac.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		bedtools intersect -a {input.k562_atac_peaks} -b {input.gm12878_atac_peaks} |
		 awk '{{print $1 "\t" $2 + 1 "\t" $3}}' |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -c > {output}
	
	"""

rule intersect_problematic_regions:
	input:
		problematic_regions = '%s/ENCFF356LFX.bed.gz' % analysis_dir,
		locus_characteristics = '%s/tmp/interruptions_atac.txt' % analysis_dir
	output: '%s/tmp/interruptions_problematic.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		gunzip -c {input.problematic_regions} |
		 awk '{{print $1 "\t" $2 + 1 "\t" $3}}' |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -c > {output}
	
	"""

rule intersect_vista_enhancers:
	input: 
		vista_bed = '%s/vistaEnhancers.bed' % analysis_dir,
		locus_characteristics = '%s/tmp/interruptions_problematic.txt' % analysis_dir
	output: '%s/tmp/interruptions_vista.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		awk '{{print $1 "\t" $2 + 1 "\t" $3 "\t" $10}}' {input.vista_bed} |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -loj |
		 bedtools groupby -g 1-24 -c 28 -o distinct > {output}
			
	"""

rule intersect_chromhmm:
	input: 
		chromhmm_bed = '%s/E002_25_imputed12marks_hg38lift_segments.bed.gz' % analysis_dir,
		locus_characteristics = '%s/tmp/interruptions_vista.txt' % analysis_dir
	output: '%s/tmp/interruptions_chromhmm.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		gunzip -c {input.chromhmm_bed} |
		awk '{{print $1 "\t" $2 + 1 "\t" $3 "\t" $4}}' |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -loj |
		 bedtools groupby -g 1-25 -c 29 -o distinct > {output}
			
	"""

rule parse_chromhmm:
	input: '%s/tmp/interruptions_chromhmm.txt' % analysis_dir
	output: '%s/tmp/interruptions_chromhmm_parsed.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/parse_chromhmm_states.py' % analysis_dir

rule create_fasta_for_nbmst:
	input: 
		allele_perfect_seq = '%s/tmp/allele_perfect_seq.{chr}.txt' % analysis_dir,
		ref_genome = ref_genome
	output: '%s/tmp/allele_perfect_seq.{chr}.fa' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/create_allele_fasta_for_nbmst.py' % analysis_dir

rule run_nbmst:
	input: '%s/tmp/allele_perfect_seq.{chr}.fa' % analysis_dir
	output: '%s/tmp/allele_perfect_seq.{chr}.motif_GQ.gff' % analysis_dir
# 	wildcard_constraints: motif = "[A-Za-z]+"
	params: sge_opts=params_default, analysis_dir=analysis_dir
	shell: """
	
		{params.analysis_dir}/non-B_gfa/gfa -seq {input} -chrom {wildcards.chr} -out {params.analysis_dir}/tmp/allele_perfect_seq.{wildcards.chr}.motif -skipSTR -skipWGET
		
		"""

MOTIFS = ['APR', 'Z', 'MR', 'IR', 'GQ', 'DR'] # ignoring STR
rule clean_up_nbmst_filenames:
	input: '%s/tmp/allele_perfect_seq.{chr}.motif_GQ.gff' % analysis_dir
	output: expand('%s/tmp/allele_perfect_seq.{{chr}}.motif_{motif}.tsv' % analysis_dir, motif = MOTIFS)
	params: sge_opts=params_default, analysis_dir=analysis_dir
	shell: """
	
		for file in {params.analysis_dir}/tmp/allele_perfect_seq.{wildcards.chr}.motif*tsv; do
		 clean=$(printf '%s\n' "$file" | grep -Po '(.*motif)')
		 clean2=$(printf '%s\n' "$file" | grep -Po '(\\_[A-Z]+\\.[a-z]+$)')
		 new="${{clean}}${{clean2}}"
		 if [[ "$file" != "$new" ]]; then
		 	cp $file $new
		 fi
		done
	
	"""

# the escape characters might be wrong above (\_ and \.)

rule parse_nbmst:
	input: 
		motif_files = expand('%s/tmp/allele_perfect_seq.{{chr}}.motif_{motif}.tsv' % analysis_dir, motif = MOTIFS),
		fasta_file = '%s/tmp/allele_perfect_seq.{chr}.fa' % analysis_dir,
		allele_perfect_seq = '%s/tmp/allele_perfect_seq.{chr}.txt' % analysis_dir
	output: '%s/tmp/major_alleles_shapes.{chr}.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/parse_nbmst.py' % analysis_dir

rule combine_major_allele_shapes:
	input: expand('%s/tmp/major_alleles_shapes.{chr}.txt' % analysis_dir, chr = AUTOSOMES)
	output: '%s/major_alleles_shapes.txt' % analysis_dir
	params: sge_opts=params_default
	shell:"""
	
	awk '{{if ($1 !~ /#/) print $0}}' {input} > {output}
	
	"""


# i'm likely to need allele if i add on future columns; this rule can just get cut
rule remove_allele_seq:
	input: '%s/tmp/interruptions_chromhmm_parsed.txt' % analysis_dir
	output: '%s/interruptions_full_annotations.txt' % analysis_dir
	params: sge_opts=params_default
	shell: 	"""
		
		 cut --complement -f5 {input} > {output}
	
	"""

