"""
Processing interruptions
"""

import glob

# load config
configfile: "interruptions_config.json"
vcf_dir=config["vcf_dir"]
ped_file=config["ped_file"]
unrelated_samples=config["unrelated_samples"]
vista_enhancers=config["vista_enhancers"]
ad_gene_list=config["ad_gene_list"]
analysis_dir=config["analysis_dir"]
genehancer_file=config["genehancer_file"]
gtf_file = config["gtf_file"]
pfam_file = config["pfam_file"]
ref_genome = config["ref_genome"]
max_idr_chip_bed = config["max_idr_chip_bed"]
cpgi_file = config["cpgi_file"]

# specify default parameters
params_default="--account=quinlan-rw --time=04:00:00 --ntasks=1 --partition=quinlan-shared-rw --mem 4096M -o slurm-%j.out -e slurm-%j.err"

AUTOSOMES = ['chr' + str(x) for x in range(1, 23)]

rule all:
	input:
		interruptions_af_homology = '%s/interruptions_full_annotations.txt' % analysis_dir,
# 		gtf_exons_w_str_pfam = '%s/gtf_coding_exons_loj_str_pfam.bed' % analysis_dir,
		coding_interruptions = '%s/coding_interruptions_full_annotations.txt' % analysis_dir,
		gnomad_interruptions = '%s/gnomad_interruptions_af_coding.txt' % analysis_dir
	params: sge_opts=params_default

rule generate_related_samples_list:
	input: 
		unrelated = unrelated_samples,
		ped = ped_file
	output: '%s/related_1kgp_samples_to_exclude.txt' % analysis_dir
	params: params_default
	script: '%s/scripts/generate_related_samples_list.py' % analysis_dir
	

# --force-samples just allows us to indicate samples to exclude that are missing from the header
rule filter_vcf_unrelated:
	input: 
		vcf='%s/ensemble_{chr}_filtered.vcf.gz' % vcf_dir,
		sample_list='%s/related_1kgp_samples_to_exclude.txt' % analysis_dir
	output: '%s/tmp/ensemble_{chr}_filtered.unrelated.vcf.gz' % analysis_dir
	params: sge_opts=params_default
	shell: """
	
	module load bcftools/1.16
	
	bcftools view -S ^{input.sample_list} {input.vcf} -O z -o {output} --force-samples
	bcftools index -t {output}
	
	"""

rule generate_locus_characteristics:
	input: '%s/tmp/ensemble_{chr}_filtered.unrelated.vcf.gz' % analysis_dir
	output: af_homology_stats='%s/tmp/interruptions_af_homology.{chr}.txt' % analysis_dir,
			allele_perfect_seq = '%s/tmp/allele_perfect_seq.{chr}.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/get_longest_homologous_sequence.py' % analysis_dir

rule cat_locus_characteristics:
	input: expand('%s/tmp/interruptions_af_homology.{chr}.txt' % analysis_dir, chr=AUTOSOMES)
	output: '%s/tmp/interruptions_af_homology.txt' % analysis_dir
	params: sge_opts=params_default
	shell: """
		awk '{{if ($1 !~ /^#/) print $0}}' {input} > {output}
	"""

# there are some repeated loci in the vcf i guess
rule annotate_locus_characteristics_w_enhancer:
	input: 
		locus_characteristics='%s/tmp/interruptions_af_homology.txt' % analysis_dir,
		vista_enhancers_file=vista_enhancers
	output: '%s/tmp/interruptions_enhancers.txt' % analysis_dir
	params: sge_opts=params_default
	shell: """
	
	module load bedtools
	
	awk '{{if ($1 !~ /chrX/) print substr($1, 4) "\t" $2 "\t" $3}}' {input.vista_enhancers_file} | \
	 sort -V -k1,1 -k2,2n | awk '{{print "chr" $0}}' | \
	 bedtools intersect -a {input.locus_characteristics} -b stdin -c | \
	 bedtools groupby -g 1-9 -c 10 -o max > {output}
	
	"""

rule annotate_w_genehancer:
	input: 
		locus_characteristics='%s/tmp/interruptions_enhancers.txt' % analysis_dir,
		genehancer=genehancer_file
	output: '%s/tmp/interruptions_genehancers.txt' % analysis_dir
	params: sge_opts=params_default
	shell: """
	
	module load bedtools
	
	gunzip -c {input.genehancer} | awk '{{if ($1 ~ /[0-9]+/) print $0}}' | \
	 sort -V -k1,1 -k2,2n | awk '{{print "chr" $1 "\t" $2 "\t" $3 "\t" $5 "\t" $6 "\t" $7}}' | \
	 bedtools intersect -a {input.locus_characteristics} -b stdin -loj | \
	 bedtools groupby -g 1-10 -c 14,15,16 -o distinct > {output}
	
	"""

rule loeuf_table_transcipts:
	input: '%s/supplementary_dataset_11_full_constraint_metrics.tsv.gz' % analysis_dir
	output: '%s/tmp/loeuf_by_transcript.bed' % analysis_dir
	params: sge_opts=params_default
	shell:"""
		gunzip -c {input} |
		 awk -F "\t" '{{if ($32 ~ /^$/ && $1 !~ /gene/) print $76 "\t" $77 "\t" $78 "\t" $1 "\t" $2 "\t" $31}}' |
		 sort -k1,1 -k2,2n > {output}
	"""

rule annotate_w_loeuf_and_ad_genes:
	input: loeuf = '%s/tmp/loeuf_by_transcript.bed' % analysis_dir,
		   ad_gene_list = ad_gene_list,
		   locus_characteristics = '%s/tmp/interruptions_genehancers.txt' % analysis_dir
	output: '%s/tmp/interruptions_loeuf.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/get_loeuf_and_ad_genes_for_genehancer_hits.py' % analysis_dir

rule process_gtf_to_bed:
	input: gtf_file
	output: '%s/tmp/gtf_coding_exons.hg38.bed' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/process_gtf_annotation.py' % analysis_dir
	

# culling some columns
# the vcf seems 1-indexed but end coord is not inclusive so i'm adding 1 to end coordinate in the gtf file
# i don't need the rest of the gtf columns for now; can add those back to the coding loci later when i analyze them
rule annotate_coding:
	input: 
		gtf_bed = '%s/tmp/gtf_coding_exons.hg38.bed' % analysis_dir,
		locus_characteristics = '%s/tmp/interruptions_loeuf.txt' % analysis_dir
	output: '%s/tmp/interruptions_coding.txt' % analysis_dir
	params: sge_opts=params_default
	shell: """
		
		module load bedtools
		bedtools merge -i {input.gtf_bed} -c 4,5 -o distinct |
		 awk '{{print $1 "\t" $2 "\t" $3 + 1 "\t" $4 "\t" $5}}' |
		 bedtools intersect -a {input.locus_characteristics} -b stdin -f 1 -loj |
		 bedtools groupby -g 1-14 -c 18,19 -o distinct,distinct > {output}
	
	"""

# some genes cannot be found in the consolidated loeuf table bc they have flags in $32
rule coding_loeuf:
	input: loeuf = '%s/tmp/loeuf_by_transcript.bed' % analysis_dir,
		   ad_gene_list = ad_gene_list,
		   locus_characteristics = '%s/tmp/interruptions_coding.txt' % analysis_dir
	output: '%s/tmp/interruptions_constraint.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/get_loeuf_and_ad_genes_for_coding_strs.py' % analysis_dir

rule annotate_coding_interruptions:
	input: 
		locus_characteristics = '%s/tmp/interruptions_constraint.txt' % analysis_dir,
		gtf_bed = '%s/tmp/gtf_coding_exons.hg38.bed' % analysis_dir,
		ref_genome = ref_genome
	output: '%s/tmp/coding_interruptions_manual_annotations.txt' % analysis_dir
	params: sge_opts=params_default
	script: '%s/scripts/annotate_coding_interruptions.py' % analysis_dir

